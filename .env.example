# =============================================
# megane — environment configuration
# Copy to .env and fill in the values.
# =============================================

# ---- LLM provider ----
LLM_PROVIDER=gemini          # gemini | openai | local
GEMINI_API_KEY=              # Required when LLM_PROVIDER=gemini
OPENAI_API_KEY=              # Required when LLM_PROVIDER=openai
LLM_LOCAL_URL=               # Required when LLM_PROVIDER=local (e.g. http://localhost:11434)
# Optional: Gemini model id — must be Gemini 3.0 or newer (e.g. gemini-3-flash-preview, gemini-3.1-flash-lite, gemini-3.1-pro-preview). Leave empty for default.
# Admin data-modeling (schema / type guessing) uses a separate model — Pro recommended for abstract field inference.
DATAMODELING_LLM_MODEL=gemini-3.1-pro-preview
# Note: gemini-3.1-flash-lite-preview is rewritten to gemini-3.1-flash-lite (GA); update Cloud/console configs to gemini-3.1-flash-lite before preview shutdown.
# Optional: max raw bytes per image for Gemini vision (default 15728640 = 15 MiB). Larger files fail fast instead of exceeding token limits.
LLM_MAX_IMAGE_BYTES=
# Max parallel LLM calls across all pipeline runs (default 2).
MAX_CONCURRENT_LLM=2
# Timeout for future synchronous LLM HTTP routes (default 10m). Background pipeline uses detached context.
LLM_REQUEST_TIMEOUT=10m
# Optional: serialized pipeline workers when InitQueue is used (default 1).
PIPELINE_QUEUE_WORKERS=1
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL=86400            # Token lifetime in seconds (default: 86400 = 24h)

# ---- Admin seed user ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ---- Application ----
# SQLite file (and -wal/-shm) live under ./.db/
DB_PATH=./.db/megane.db
PROJECTS_DIR=./projects
PORT=8080

# ---- Caddy (reverse proxy in docker compose) ----
# :80 = HTTP on public IP (AWS without a domain)
# your.domain.com = automatic HTTPS (point DNS here; set CADDY_ACME_EMAIL)
CADDY_DOMAIN=:80
CADDY_ACME_EMAIL=
