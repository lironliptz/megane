# =============================================
# megane — environment configuration
# Copy to .env and fill in the values.
# =============================================

# ---- LLM provider ----
LLM_PROVIDER=gemini          # gemini | openai | local
GEMINI_API_KEY=              # Required when LLM_PROVIDER=gemini
OPENAI_API_KEY=              # Required when LLM_PROVIDER=openai
LLM_LOCAL_URL=               # Required when LLM_PROVIDER=local (e.g. http://localhost:11434)
# Optional: Gemini model id — must be Gemini 3.0 or newer (e.g. gemini-3-flash-preview, gemini-3.1-flash-lite, gemini-3.1-pro-preview). Leave empty for default.
# Admin data-modeling (schema / type guessing) uses a separate model — Pro recommended for abstract field inference.
DATAMODELING_LLM_MODEL=gemini-3.1-pro-preview
# Note: gemini-3.1-flash-lite-preview is rewritten to gemini-3.1-flash-lite (GA); update Cloud/console configs to gemini-3.1-flash-lite before preview shutdown.
# Optional: max raw bytes per image for Gemini vision (default 15728640 = 15 MiB). Larger files fail fast instead of exceeding token limits.
LLM_MAX_IMAGE_BYTES=
# Max parallel LLM calls across all pipeline runs (default 2).
MAX_CONCURRENT_LLM=2
# Timeout for future synchronous LLM HTTP routes (default 10m). Background pipeline uses detached context.
LLM_REQUEST_TIMEOUT=10m
# Optional: serialized pipeline workers when InitQueue is used (default 1).
PIPELINE_QUEUE_WORKERS=1
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL=86400            # Token lifetime in seconds (default: 86400 = 24h)

# ---- Admin seed user ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ---- Application ----
# SQLite file (and -wal/-shm) live under ./.db/
DB_PATH=./.db/megane.db
PROJECTS_DIR=./projects
PORT=8080

# ---- Caddy (reverse proxy in docker compose) ----
# :80 = HTTP on public IP (AWS without a domain)
# your.domain.com = automatic HTTPS (point DNS here; set CADDY_ACME_EMAIL)
CADDY_DOMAIN=:80
CADDY_ACME_EMAIL=

# ---- Company file database (phase 1 read model) ----
# Root folder containing companies/{cik}/ ; read-only.
FILEDB_DIR=./fileDB
# How long a scanned company is cached before it is re-read from disk.
FILEDB_CACHE_TTL=5m

# ---- Filing financial extraction (phase 8) ----
# Deterministic extraction (XBRL instance + rendered HTML cross-check) always runs and
# needs no key. These settings only control the OPTIONAL LLM adjudicator, which is asked
# to choose between conflicting deterministic readings — it never extracts a figure and
# never overwrites a verified one. Off by default: with this unset, a disputed metric is
# withheld from the timeline modal rather than shown.
EDGAR_FINANCIALS_LLM=0            # 1 = enable the adjudicator for `suspect` metrics only
# Weakest sufficient model: adjudication is a constrained multiple-choice task over a
# short quoted passage, so the lite tier is the right size. Must be a Gemini 3.0+ id in
# `gemini-<major>...` form — a dotted name like `gemini.3.5-flash-lite` is rejected by
# ValidateGeminiModelID (internal/llm/gemini.go).
EDGAR_FINANCIALS_LLM_MODEL=gemini-3.5-flash-lite
# Max evidence characters sent per adjudication (press-release passage, not whole exhibit).
EDGAR_FINANCIALS_LLM_MAX_EVIDENCE=4000

# ---- Market data (phase 3 company timeline) ----
MARKET_DATA_PROVIDER=yahoo        # yahoo | tiingo (primary provider; Yahoo needs no key)
MARKET_DATA_API_KEY=              # Tiingo API token — used as the Yahoo-primary fallback
                                   # whenever set, regardless of MARKET_DATA_PROVIDER above;
                                   # unused by Yahoo. Get one free at tiingo.com.
MARKET_DATA_USER_AGENT=           # Overrides the built-in Yahoo User-Agent. Yahoo returns
                                   # HTTP 429 for Go's default UA, so leave this set unless
                                   # you have a reason to change it.
STOCK_FETCH_ON_COMPANY_OPEN=false # eager-fetch prices when a company page opens
# First-visit backfill walks a company's full price history backward in
# calendar-year chunks rather than one giant request (politeness; avoids
# provider throttling). Only chunk span/delay are tunable — retry count (3)
# and the 429 backoff ladder (2s/8s/30s) are fixed.
MARKET_DATA_CHUNK_YEARS=5         # calendar years per backfill chunk
MARKET_DATA_CHUNK_DELAY=400ms     # pause between chunks (Go duration syntax)
